  "reference_sha256": "50d9d39cc68190348d8da0b16432b3a3d8ac057c5ed7b4dcb462d8540521c138",
  "query_text": "An attacker changes the claimed final result and the verifier still accepts. Which missing boundary condition allows this forgery?",
  "texts": [
    {
      "id": "pi01",
      "label": "proof_integrity",
      "text": "The prover can put an out-of-range value into the witness and still pass verification. We need a constraint that rejects the invalid assignment."
    },
    {
      "id": "pi02",
      "label": "proof_integrity",
      "text": "A negative integer is being interpreted as a large field residue. Establish the signed arithmetic contract and prove that the conversion preserves the claimed result."
    },
    {
      "id": "rp01",
      "label": "runtime_performance",
      "text": "Generating the proof takes too long because every multiplication emits a separate trace. Batch the work and measure total latency and memory consumption."
    },
    {
      "id": "rp02",
      "label": "runtime_performance",
      "text": "The cryptographic kernel spends most of its time allocating and copying coefficient buffers. Reuse storage and benchmark the complete request before and after the change."
    },
    {
      "id": "pi03",
      "label": "proof_integrity",
      "text": "The receipt identifies the output but does not identify the parent state. Bind the complete transition context so a proof cannot be attached to a different history."
    },
    {
      "id": "pi04",
      "label": "proof_integrity",
      "text": "A theorem assumes a relation that has no satisfying witness. Construct a nonzero valid example and identify the premise that makes the soundness statement meaningful."
    },
    {
      "id": "pi05",
      "label": "proof_integrity",
      "text": "The last row of the execution trace is not checked by the transition constraint. Make sure a malicious final output cannot escape the verifier's checks."
    },
    {
      "id": "pi06",
      "label": "proof_integrity",
      "text": "The verifier checks each polynomial separately, but the openings may not describe the same committed computation. Prove consistency of the batch and its shared challenge."
    },
    {
      "id": "pi07",
      "label": "proof_integrity",
      "text": "The certificate proves equality modulo a prime but the application needs rounded integer division. State the quotient and remainder bounds and rule out wraparound."
    },
    {
      "id": "pi08",
      "label": "proof_integrity",
      "text": "A cached acceptance can be replayed against a changed model revision. Require the accepted proof to match the current model, query and designated recipient."
    },
    {
      "id": "pi09",
      "label": "proof_integrity",
      "text": "After an old checkpoint is restored, a spent authorization becomes available again. Specify the finality rule and demonstrate that the restored branch cannot spend it twice."
    },
    {
      "id": "pi10",
      "label": "proof_integrity",
      "text": "The proof system validates an intermediate value while the reader decrypts a different ciphertext. Connect the exact verified output bytes to the released answer."
    }
  ],
